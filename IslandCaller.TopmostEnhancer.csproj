<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 重构 v2：完全复刻 IslandCaller 官方可加载的构建方式——
         标准 PackageReference ClassIsland.PluginSdk + AnyCPU，
         由 .NET SDK 生成 deps.json（.NET 10 SDK 生成精简 deps.json 是
         .NET 10 体系标准行为，与 .NET 10 宿主配套；.NET 8 宿主才要求完整版）。
         宿主 ClassIsland 2.1.1.x 为 net10.0-windows + Avalonia 12。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 不设 PlatformTarget：保持 AnyCPU（与 IslandCaller 一致） -->
    <Version>1.1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- 与宿主 ClassIsland 2.1.1.x 匹配的 SDK 版本（镜像含 Avalonia 12.1.1 依赖链） -->
    <PackageReference Include="ClassIsland.PluginSdk" Version="2.1.1.1">
      <ExcludeAssets>runtime; native</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 排除仓库内并列的 net8 稳定版子目录，避免 SDK 通配符将其一并编译进本程序集 -->
    <Compile Remove="IslandCallerTopmostEnhancer.NET8\**" />
    <None Remove="IslandCallerTopmostEnhancer.NET8\**" />
    <Content Remove="IslandCallerTopmostEnhancer.NET8\**" />
    <Page Remove="IslandCallerTopmostEnhancer.NET8\**" />
    <EmbeddedResource Remove="IslandCallerTopmostEnhancer.NET8\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
