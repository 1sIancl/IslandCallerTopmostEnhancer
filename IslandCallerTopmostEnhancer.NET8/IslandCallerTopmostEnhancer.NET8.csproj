<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 重构 v2：完全复刻 IslandCaller 2.0.1.3 官方可加载的构建方式。
         标准 PackageReference ClassIsland.PluginSdk + AnyCPU，
         由 .NET SDK 生成完整 deps.json（此前手动 Reference 方式生成的
         简化 deps.json 导致 hostfxr 组件模式报 -2147450734）。 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 不设 PlatformTarget：必须 AnyCPU（与 IslandCaller 2.0.1.3 一致） -->
    <Version>1.0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- 完全复刻 IslandCaller 2.0.1.3（可正常加载）的 SDK 版本：
         镜像上 2.1.0.1 的传递依赖 Avalonia.FreeDesktop 11.3.17 缺失，
         2.0.0.2 依赖链完整可还原。宿主 ClassIsland 2.1.0.1 兼容 apiVersion 2.0.0.2。 -->
    <PackageReference Include="ClassIsland.PluginSdk" Version="2.0.0.2">
      <ExcludeAssets>runtime; native</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
