<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ClassIsland 2.1.0.1 稳定版宿主为 .NET 8（net8.0-windows + WindowsDesktop.App）。
         插件必须用 net8.0-windows 编译：纯 net8.0 的组件在 hostfxr 组件模式下
         会报 "Failed to locate managed application"（-2147450734）。
         IslandCaller 2.0.1.3 同为 net8.0-windows。 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- 插件依赖（Avalonia / ClassIsland 等）由 ClassIsland 宿主提供，不打进插件包 -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Version>1.0.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      编译期程序集引用目录：指向 ClassIsland 2.1.0.1 发布包解压目录（app-2.1.0.1-0）。
      标准做法是引用 NuGet 包 ClassIsland.PluginSdk（2.0.0.2），
      本工程为便于离线构建，改为直接引用发布包内的程序集。可用
      -p:ClassIslandRuntimeDir=... 覆盖。
    -->
    <ClassIslandRuntimeDir Condition="'$(ClassIslandRuntimeDir)' == ''">$(MSBuildProjectDirectory)\..\ci2101\app-2.1.0.1-0</ClassIslandRuntimeDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- 仅编译期引用，不复制到输出（宿主运行时自带这些程序集） -->
    <Reference Include="$(ClassIslandRuntimeDir)/*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
